# Dockerfile.base — shared deps for trainer, converter, simulator
FROM python:3.10-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends libhdf5-dev gcc libc6-dev \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip && pip install \
    tensorflow==2.15.1 \
    numpy==1.26.4 \
    pandas==2.2.1 \
    scikit-learn==1.4.2 \
    paho-mqtt==2.1.0

WORKDIR /workspace
